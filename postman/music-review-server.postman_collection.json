          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"ALBUM\",\n  \"spotifyId\": \"4aawyAB9vmqN3uQ7FjRGTy\",\n  \"item\": { \"name\": \"Global Warming\" },\n  \"rating\": 4.3\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/reviews"
          }
        },
