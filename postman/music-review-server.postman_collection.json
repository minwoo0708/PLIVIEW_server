            "}"
          ] } }],
          "request": {
            "method": "PATCH",
            "header": [],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 5.0,\n  \"tags\": [\"명곡\"]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/reviews/{{reviewId}}",
