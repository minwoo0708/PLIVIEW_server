            "    pm.test('Location 헤더', () => pm.response.to.have.header('Location'));",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"TRACK\",\n  \"spotifyId\": \"4uLU6hMCjMI75M1A2tKUQC\",\n  \"item\": {\n    \"name\": \"Never Gonna Give You Up\",\n    \"subtitle\": \"Rick Astley\",\n    \"imageUrl\": \"https://i.scdn.co/image/ab67616d0000b27315ebbedaacef61af244262a8\"\n  },\n  \"rating\": 4.5,\n  \"comment\": \"몇 번을 들어도 좋다\",\n  \"tags\": [\"신나는\", \"80년대\"]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/reviews",
            "description": "성공하면 reviewId가 자동 저장됩니다."
          }
        },
        {
          "name": "리뷰 작성 (플레이리스트)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) {",
            "    pm.environment.set('playlistReviewId', pm.response.json().id);",
            "    pm.test('playlistScores 있음', () => pm.expect(pm.response.json().playlistScores).to.not.be.null);",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"PLAYLIST\",\n  \"spotifyId\": \"3cEYpjA9oz9GiPac4AsH4n\",\n  \"item\": {\n    \"name\": \"새벽 드라이브\",\n    \"subtitle\": \"smedjan\"\n  },\n  \"rating\": 4.5,\n  \"conceptScore\": 5.0,\n  \"flowScore\": 4.5,\n  \"discoveryScore\": 3.5,\n  \"snapshotId\": \"MTY4NjY2OTQ0MCwwMDAwMDAwMA==\",\n  \"ownerSpotifyId\": \"smedjan\",\n  \"comment\": \"곡 순서가 자연스럽다\",\n  \"tags\": [\"드라이브\"]\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/reviews"
          }
        },
        {
          "name": "[실패] 같은 곡 중복 작성 → 409",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
