            "    pm.response.to.have.status(409);",
            "    pm.expect(pm.response.json().code).to.eql('REVIEW_ALREADY_EXISTS');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "{\n  \"type\": \"TRACK\",\n  \"spotifyId\": \"4uLU6hMCjMI75M1A2tKUQC\",\n  \"item\": { \"name\": \"Never Gonna Give You Up\" },\n  \"rating\": 3.0\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/reviews"
          }
        },
