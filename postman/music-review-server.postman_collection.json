          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"TRACK\",\n  \"spotifyId\": \"11dFghVXANMlKmJXsNCbNl\",\n  \"item\": { \"name\": \"Cut To The Feeling\" },\n  \"rating\": 4.0,\n  \"flowScore\": 3.0\n}",
              "options": { "raw": { "language": "json" } }
